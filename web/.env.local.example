# Local dev: point at a local libSQL file. In production, use a Turso database URL + auth token instead.
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# Random string, 32+ chars. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Used once, only to seed the first admin user (npm run db:seed). Not read after that.
ADMIN_PASSWORD=

# Vercel Blob token for image uploads (from Vercel project settings > Storage > Blob)
BLOB_READ_WRITE_TOKEN=

# Contact form notifications via Resend. CONTACT_FROM_EMAIL must be on a domain verified in Resend;
# leave it unset to use Resend's onboarding sender, which only delivers to the Resend account owner.
RESEND_API_KEY=
CONTACT_TO_EMAIL=dibe@tarsusstudios.com
CONTACT_FROM_EMAIL=
